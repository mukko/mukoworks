---
import { Picture } from "astro:assets";

import "@styles/global.css";

import Layout from "../../../layouts/Layout.astro";
import ShareButtons from "@components/ShareButtons.astro";

import Logo from "@assets/bitflip/package.png";
import { YouTube } from "@astro-community/astro-embed-youtube";

const title = "BITFLIP";
const min_p = "3";
const max_p = "5";
const minutes = "30";
const min_age = "12";
---

<Layout
    title="BITFLIP | mukoworks"
    description="勝負に勝ってビットを集めろ"
    ogImage="/mukoworks/ogp/bitflip.png"
>
    <section class="hero w-full py-6">
        <div class="max-w-screen-lg mx-auto">
            <div class="flex flex-col md:flex-row-reverse md:items-center">
                <div class="md:w-1/3 flex justify-center items-center p-12">
                    <Picture
                        class="max-h-80 w-auto object-contain shadow-xl/40"
                        src={Logo}
                        formats={["avif", "webp"]}
                        alt="bitflip package image"
                    />
                </div>
                <div class="md:w-2/3 p-12">
                    <h1 class="text-6xl font-black mb-4">{title}</h1>
                    <p class="text-3xl font-bold">勝負に勝ってビットを集めろ</p>
                    <div class="max-h-80">
                        <p class="pt-8 text-xl">
                            場で一番強い人が総取りのトリックテイキングゲーム。
                            なるべく1が多いときに勝とう！
                        </p>
                        <p class="pt-8 text-xl">
                            最弱カードを出すと強さを反転できます。タイミングはどうする？
                            シンプルなトリテながら、いつ勝つべきかの駆け引きが深く楽しめます。
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="hero w-full pb-24 mx-auto">
        <div class="max-w-screen-lg mx-auto px-12">
            <div
                class="grid grid-cols-3 rounded-lg border-2 border-solid divide-x-2 divide-dashed divide-white overflow-hidden"
            >
                <div class="flex items-center justify-center text-center">
                    {min_p}-{max_p}人用
                </div>
                <div class="flex items-center justify-center text-center">
                    プレイ時間{minutes}分
                </div>
                <div class="flex items-center justify-center text-center">
                    対象年齢{min_age}以上
                </div>
            </div>
        </div>
    </section>

    <ShareButtons
        url="https://mukko.github.io/mukoworks/products/bitflip"
        title="BITFLIP - 勝負に勝ってビットを集めろ"
    />

    <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

    <section class="w-full mx-auto py-6">
        <div class="max-w-screen-lg mx-auto px-12">
            <details class="border border-gray-200 rounded-lg p-4">
                <summary
                    class="font-bold text-lg cursor-pointer hover:text-blue-600 bg-red-500 text-white p-2 rounded"
                >
                    エラッタ
                </summary>
                <div class="mt-4 text-gray-700">
                    <h3 class="font-semibold mb-2">エラッタ</h3>
                    <ul class="list-disc list-inside space-y-2">
                        <li>入稿データのミスで赤カードの記号が間違っていました。訂正用のシールを同梱しています。</li>
                        <ul>
                            <li>誤: ◆</li>
                            <li>正: ♥</li>
                        </ul>
                    </ul>
                </div>
            </details>
        </div>

        <section class="w-full mx-auto py-6">
            <div class="max-w-screen-lg mx-auto">
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 flex p-2 md:p-12">
                        <h1 class="text-xl md:text-3xl font-bold">
                            遊び方動画
                        </h1>
                    </div>
                    <div class="md:w-2/3 p-2 md:p-12">
                        <YouTube id="_LfvUK_mNlU" />
                    </div>
                </div>
            </div>
        </section><div
            class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"
        >
        </div>

        <section class="w-full mx-auto py-6">
            <div class="max-w-screen-lg mx-auto">
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 flex p-2 md:p-12">
                        <h1 class="text-xl md:text-3xl font-bold">
                            ゲームの説明
                        </h1>
                    </div>
                    <div class="md:w-2/3 p-2 md:p-12">
                        <p class="md:text-xl">
                            各プレイヤーは配られたカードでトリックを重ねていきます。トリックごとの勝負は10進数の数字の大小で決まります。
                            勝者はトリックのカードを回収できますが、最終的に競うのは回収したカード中央に書かれたビットの数。1を多く集めた人が勝ちです。
                        </p>
                        <br />
                        <p class="md:text-xl">
                            ただし、そのときの場の強さでの最弱カードを出すと強さが反転する特殊ルールがあります。いつ勝つべきか、どのカードを出すべきか、シンプルなルールながら深い駆け引きが楽しめます。
                        </p>
                        <br />
                        <p class="md:text-xl">
                            トリックテイキングゲーム入門にも良いゲームです。ぜひ遊んでみてください！
                        </p>
                        <br />
                        <ul class="md:text-xl list-disc pl-6 space-y-2">
                            <li>マストフォロー</li>
                            <li>切り札有り</li>
                            <li>ビッドなし</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

        <section class="w-full mx-auto py-6">
            <div class="max-w-screen-lg mx-auto">
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col md:flex-row">
                        <div class="md:w-1/3 flex p-2 md:p-12">
                            <h1 class="text-xl md:text-3xl font-bold">
                                頒布予定日
                            </h1>
                        </div>
                        <div class="md:w-2/3 flex p-2 md:p-12">
                            <p class="text-xl">
                                2026/05/23 Sat. ゲームマーケット 2026春 T05
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-col md:flex-row">
                        <div class="md:w-1/3 flex p-2 md:p-12">
                            <h1 class="text-xl md:text-3xl font-bold">
                                頒布価格
                            </h1>
                        </div>
                        <div class="md:w-2/3 flex p-2 md:p-12">
                            <p class="text-xl">2,000円</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

        <section class="w-full mx-auto py-6">
            <div class="max-w-screen-lg mx-auto">
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col md:flex-row">
                        <div class="md:w-1/3 flex p-2 md:p-12">
                            <h1 class="text-xl font-bold">Special Thanks</h1>
                        </div>
                        <div class="md:w-2/3 flex p-2 md:p-12">
                            <ul>
                                <li>
                                    <a
                                        href="https://est.mnd.co.jp/estimate/simulation"
                                        >印刷：萬印堂</a
                                    >
                                </li>
                                <li>
                                    <a
                                        href="https://fontmeme.com/jfont/xolonium-font/"
                                        >フォント：Xolonium</a
                                    >
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                section.hero {
                    background-color: #1a2a4a;
                    color: #ffffff;
                }
            </style>
        </section>
    </section>
</Layout>
