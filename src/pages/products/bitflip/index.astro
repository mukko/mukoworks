---
import { Picture } from "astro:assets";

import "@styles/global.css";

import Layout from "../../../layouts/Layout.astro";
import ShareButtons from "@components/ShareButtons.astro";

import Logo from "@assets/bitflip/package.png";

const title = "BITFLIP";
const min_p = "3";
const max_p = "5";
const minutes = "30";
const min_age = "12";
---

<Layout title="BITFLIP | mukoworks" description="勝負に勝ってビットを集めろ" ogImage="/mukoworks/ogp/bitflip.png">
    <section class="hero w-full py-6">
        <div class="max-w-screen-lg mx-auto">
            <div class="flex flex-col md:flex-row-reverse md:items-center">
                <div class="md:w-1/3 flex justify-center items-center p-12">
                    <Picture
                        class="max-h-80 w-auto object-contain shadow-xl/40"
                        src={Logo}
                        formats={["avif", "webp"]}
                        alt="bitflip package image"
                    />
                </div>
                <div class="md:w-2/3 p-12">
                    <h1 class="text-6xl font-black mb-4">{title}</h1>
                    <p class="text-3xl font-bold">勝負に勝ってビットを集めろ</p>
                    <div class="max-h-80">
                        <p class="pt-8 text-xl">
                            場で一番強い人が総取りのトリックテイキングゲーム。
                            なるべく1が多いときに勝とう！
                        </p>
                        <p class="pt-8 text-xl">
                            最弱カードを出すと強さを反転できます。タイミングはどうする？
                            シンプルなトリテながら、いつ勝つべきかの駆け引きが深く楽しめます。
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="hero w-full pb-24 mx-auto">
        <div class="max-w-screen-lg mx-auto px-12">
            <div
                class="grid grid-cols-3 rounded-lg border-2 border-solid divide-x-2 divide-dashed divide-white overflow-hidden"
            >
                <div class="flex items-center justify-center text-center">
                    {min_p}-{max_p}人用
                </div>
                <div class="flex items-center justify-center text-center">
                    プレイ時間{minutes}分
                </div>
                <div class="flex items-center justify-center text-center">
                    対象年齢{min_age}以上
                </div>
            </div>
        </div>
    </section>

    <ShareButtons url="https://mukko.github.io/mukoworks/products/bitflip" title="BITFLIP - 勝負に勝ってビットを集めろ" />

    <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

    <section class="w-full mx-auto py-6">
        <div class="max-w-screen-lg mx-auto">
            <div class="flex flex-col md:flex-row">
                <div class="md:w-1/3 flex p-2 md:p-12">
                    <h1 class="text-xl md:text-3xl font-bold">ゲームの説明</h1>
                </div>
                <div class="md:w-2/3 p-2 md:p-12">
                    <p class="md:text-xl">
                        仮置き文章各プレイヤーはビット列を持ちます。手札のカードを使ってビットを反転させ、
                        目標のビットパターンを完成させたプレイヤーが勝利です。
                    </p>
                    <br />
                    <p class="md:text-xl">
                        仮置き文章相手のビットを妨害するカードや、一気に複数ビットを反転させる強力なカードも。
                        読み合いと計算で勝負を制しましょう！
                    </p>
                </div>
            </div>
        </div>
    </section>

    <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

    <section class="w-full mx-auto py-6">
        <div class="max-w-screen-lg mx-auto">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 flex p-2 md:p-12">
                        <h1 class="text-xl md:text-3xl font-bold">
                            頒布予定日
                        </h1>
                    </div>
                    <div class="md:w-2/3 flex p-2 md:p-12">
                        <p class="text-xl">
                            2026/05/23 ゲームマーケット 2026春
                        </p>
                    </div>
                </div>
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 flex p-2 md:p-12">
                        <h1 class="text-xl md:text-3xl font-bold">頒布価格</h1>
                    </div>
                    <div class="md:w-2/3 flex p-2 md:p-12">
                        <p class="text-xl">2,000円</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="border-b-2 border-b-gray-200 max-w-screen-lg mx-auto"></div>

    <section class="w-full mx-auto py-6">
        <div class="max-w-screen-lg mx-auto">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 flex p-2 md:p-12">
                        <h1 class="text-xl font-bold">Special Thanks</h1>
                    </div>
                    <div class="md:w-2/3 flex p-2 md:p-12">
                        <ul>
                            <li>
                                <a href="https://est.mnd.co.jp/estimate/simulation">印刷：萬印堂</a>
                            </li>
                            <li>
                                <a href="https://fontmeme.com/jfont/xolonium-font/">フォント：Xolonium</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <style>
            section.hero {
                background-color: #1a2a4a;
                color: #ffffff;
            }
        </style>
    </section></Layout
>
